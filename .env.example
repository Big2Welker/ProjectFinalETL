# 1. MySQL Data Warehouse & Streaming Metrics Store Credentials
DB_USER=root
DB_PASSWORD=tu_password_seguro_aqui
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dw_calidad_agua_colombia

# 2. Secondary Dynamic Source Configuration (API Colombia - Open Public REST API)
API_COLOMBIA_BASE_URL=https://api-colombia.com/api/v1
API_TIMEOUT_SECONDS=25
API_PAGE_SIZE=200

# 3. Apache Kafka Event Streaming Configuration (KRaft Mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC_TELEMETRY=irca.water.telemetry.v1
KAFKA_CONSUMER_GROUP=cg_irca_streaming_analytics_v1

# 4. Batch Reliability Test B Flag (Controlled Critical Quality Failure)
INJECT_CRITICAL_FAILURE=false
